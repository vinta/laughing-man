{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/ensure-build.sh\"",
            "timeout": 30,
            "statusMessage": "Building dist/..."
          }
        ]
      }
    ]
  }
}
